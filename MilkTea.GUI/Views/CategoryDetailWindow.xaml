<Window x:Class="MilkTea.GUI.Views.CategoryDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Category Detail" 
        Height="480" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF6B35" Padding="20,15">
            <TextBlock x:Name="txtTitle"
                       Text="Thêm danh mục" 
                       FontSize="24" 
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center" Height="60"/>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="40,25,40,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Category ID (only shown for update) -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20" x:Name="pnlCategoryId" Visibility="Collapsed">
                <TextBlock Text="Category ID:" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Foreground="#FF6B35"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="txtCategoryId"
                         Style="{StaticResource ModernTextBox}"
                         Height="42"
                         IsReadOnly="True"
                         Background="#F0F0F0"/>
            </StackPanel>

            <!-- Category Name -->
            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                <TextBlock Text="Tên danh mục:" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Foreground="#FF6B35"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="txtCategoryName"
                         Style="{StaticResource ModernTextBox}"
                         Height="42"
                         MaxLength="50"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        Margin="0,15,0,0">
                <Button Content="Lưu"
                        Style="{StaticResource ModernButton}"
                        Background="#4CAF50"
                        Width="160"
                        Height="48"
                        FontSize="16"
                        Margin="0,0,15,0"
                        Click="BtnSave_Click"/>
                <Button Content="Đóng"
                        Style="{StaticResource ModernButton}"
                        Background="#607D8B"
                        Width="160"
                        Height="48"
                        FontSize="16"
                        Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
