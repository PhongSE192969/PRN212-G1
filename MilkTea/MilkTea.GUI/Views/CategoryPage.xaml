<Window x:Class="MilkTea.GUI.Views.CategoryPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Category Management" 
        Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF6B35" Padding="20,15">
            <Grid>
                <TextBlock Text="Quản lí danh mục" 
                           FontSize="24" 
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- DataGrid -->
            <Border Grid.Row="0" 
                    Background="White" 
                    CornerRadius="10" 
                    Padding="20"
                    Margin="0,0,0,20">
                <DataGrid x:Name="dgCategories"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#F9F9F9"
                          FontSize="14"
                          RowHeight="35"
                          SelectionChanged="DgCategories_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" 
                                            Binding="{Binding CategoryId}" 
                                            Width="100"/>
                        <DataGridTextColumn Header="Tên danh mục" 
                                            Binding="{Binding CategoryName}" 
                                            Width="*"/>
                        <DataGridTextColumn Header="Số lượng sản phẩm" 
                                            Binding="{Binding Products.Count}" 
                                            Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="1" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right">
                <Button Content="Tạo"
                        Style="{StaticResource ModernButton}"
                        Background="#4CAF50"
                        Width="130"
                        Height="50"
                        FontSize="16"
                        Margin="0,0,12,0"
                        Click="BtnCreate_Click"/>
                <Button Content="Sửa"
                        Style="{StaticResource ModernButton}"
                        Background="#2196F3"
                        Width="130"
                        Height="50"
                        FontSize="16"
                        Margin="0,0,12,0"
                        Click="BtnUpdate_Click"/>
                <Button Content="Xoá"
                        Style="{StaticResource ModernButton}"
                        Background="#F44336"
                        Width="130"
                        Height="50"
                        FontSize="16"
                        Margin="0,0,12,0"
                        Click="BtnDelete_Click"/>
                <Button Content="Đóng"
                        Style="{StaticResource ModernButton}"
                        Background="#607D8B"
                        Width="130"
                        Height="50"
                        FontSize="16"
                        Click="BtnQuit_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
