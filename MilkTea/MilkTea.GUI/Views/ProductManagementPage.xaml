<Window x:Class="MilkTea.GUI.Views.ProductManagementPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý Sản phẩm &amp; Topping"
        Height="700" Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="📦 QUẢN LÝ SẢN PHẨM &amp; TOPPING"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#FF6B35"
                   Margin="0,0,0,20"/>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" Background="White">
            <!-- TAB SẢN PHẨM -->
            <TabItem Header="🧋 Sản phẩm" FontSize="16">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Product Action Buttons -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="➕ Thêm"
                                Style="{StaticResource ModernButton}"
                                Background="#4CAF50"
                                Width="100"
                                Height="40"
                                Margin="0,0,10,0"
                                Click="BtnAddProduct_Click"/>
                        <Button Content="✏️ Sửa"
                                Style="{StaticResource ModernButton}"
                                Background="#2196F3"
                                Width="100"
                                Height="40"
                                Margin="0,0,10,0"
                                Click="BtnEditProduct_Click"/>
                        <Button Content="🗑️ Xóa"
                                Style="{StaticResource ModernButton}"
                                Background="#F44336"
                                Width="100"
                                Height="40"
                                Click="BtnDeleteProduct_Click"/>
                    </StackPanel>

                    <!-- Product DataGrid -->
                    <DataGrid Grid.Row="1"
                              x:Name="dgProducts"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              AlternatingRowBackground="#F9F9F9"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ProductId}" Width="60"/>
                            <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Danh mục" Binding="{Binding CategoryName}" Width="150"/>
                            <DataGridTextColumn Header="Giá" Binding="{Binding DisplayPrice}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB TOPPING -->
            <TabItem Header="🍓 Topping" FontSize="16">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Topping Action Buttons -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="➕ Thêm"
                                Style="{StaticResource ModernButton}"
                                Background="#4CAF50"
                                Width="100"
                                Height="40"
                                Margin="0,0,10,0"
                                Click="BtnAddTopping_Click"/>
                        <Button Content="✏️ Sửa"
                                Style="{StaticResource ModernButton}"
                                Background="#2196F3"
                                Width="100"
                                Height="40"
                                Margin="0,0,10,0"
                                Click="BtnEditTopping_Click"/>
                        <Button Content="🗑️ Xóa"
                                Style="{StaticResource ModernButton}"
                                Background="#F44336"
                                Width="100"
                                Height="40"
                                Click="BtnDeleteTopping_Click"/>
                    </StackPanel>

                    <!-- Topping DataGrid -->
                    <DataGrid Grid.Row="1"
                              x:Name="dgToppings"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              AlternatingRowBackground="#F9F9F9"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ToppingId}" Width="60"/>
                            <DataGridTextColumn Header="Tên topping" Binding="{Binding ToppingName}" Width="*"/>
                            <DataGridTextColumn Header="Giá" Binding="{Binding Price, StringFormat='{}{0:N0} đ'}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="🚪 Thoát"
                    Style="{StaticResource ModernButton}"
                    Background="#9E9E9E"
                    Width="120"
                    Height="45"
                    FontSize="16"
                    Click="BtnExit_Click"/>
        </StackPanel>
    </Grid>
</Window>